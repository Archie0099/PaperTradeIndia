+  const nullSpec = (seed, gated) => {
+    const sp = {
+      kind: 'BASKET', name: `null-${seed}`, universe: sampleNames(universe, xsSpec.k, seed),
+      rank: ['*', 0, ['vol', 20]], k: xsSpec.k, weighting: xsSpec.weighting, rebalanceBars: xsSpec.rebalanceBars,
+    };
